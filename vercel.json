{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/avto-z-ssha",
      "destination": "/avto-z-ssha.html"
    },
    {
      "source": "/avto-z-yevropy",
      "destination": "/avto-z-yevropy.html"
    },
    {
      "source": "/avto-z-korei",
      "destination": "/avto-z-korei.html"
    },
    {
      "source": "/kontakty",
      "destination": "/kontakty.html"
    },
    {
      "source": "/avtopidbir",
      "destination": "/avtopidbir.html"
    },
    {
      "source": "/avtovykup",
      "destination": "/avtovykup.html"
    },
    {
      "source": "/polityka-konfidentsiynosti",
      "destination": "/polityka-konfidentsiynosti.html"
    },
    {
      "source": "/rozmytnennya",
      "destination": "/rozmytnennya.html"
    },
    {
      "source": "/vidhuky",
      "destination": "/vidhuky.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "severovauto.vercel.app"
        }
      ],
      "destination": "https://www.autogroup.top/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/avto-z-ssha.html",
      "destination": "/avto-z-ssha",
      "permanent": true
    },
    {
      "source": "/avto-z-yevropy.html",
      "destination": "/avto-z-yevropy",
      "permanent": true
    },
    {
      "source": "/avto-z-korei.html",
      "destination": "/avto-z-korei",
      "permanent": true
    },
    {
      "source": "/kontakty.html",
      "destination": "/kontakty",
      "permanent": true
    },
    {
      "source": "/avtopidbir.html",
      "destination": "/avtopidbir",
      "permanent": true
    },
    {
      "source": "/avtovykup.html",
      "destination": "/avtovykup",
      "permanent": true
    },
    {
      "source": "/polityka-konfidentsiynosti.html",
      "destination": "/polityka-konfidentsiynosti",
      "permanent": true
    },
    {
      "source": "/rozmytnennya.html",
      "destination": "/rozmytnennya",
      "permanent": true
    },
    {
      "source": "/vidhuky.html",
      "destination": "/vidhuky",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
